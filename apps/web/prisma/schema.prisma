generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// USER & AUTHENTICATION

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String? // scrypt hash — null for OAuth-only users

  // TOTP 2FA
  totpSecret  String? // Encrypted TOTP secret
  totpEnabled Boolean @default(false)

  // Email OTP 2FA
  emailOtpEnabled Boolean @default(false)

  // 2FA method preference
  twoFactorMethod TwoFactorMethod @default(NONE)

  // Optional master key for additional encryption layer
  masterKeyHash String?
  masterKeySalt String?

  // Password reset (email/password users only)
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  // Account status
  isActive   Boolean @default(true)
  isVerified Boolean @default(false)

  // Email verification
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?

  // Brute-force protection
  failedLoginCount Int       @default(0)
  lockoutUntil     DateTime?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Passkeys
  passkeyEnabled        Boolean   @default(false)
  /// "Passkey only": refuse password sign-in (needs a passkey; cleared when the last one is removed or on password reset)
  passwordLoginDisabled Boolean   @default(false)
  /// Lock the app after this many idle minutes (null = never).
  lockAfterMinutes      Int?
  /// Look and layout choices (lib/appearance/prefs.ts); null = defaults.
  appearance            Json?
  /// When the user finished (or skipped) the first-run setup; null = show it.
  onboardedAt           DateTime?

  // Relations
  sessions            Session[]
  servers             Server[]
  serverGroups        ServerGroup[]
  auditLogs           AuditLog[]
  recoveryCodes       RecoveryCode[]
  emailOTPs           EmailOTP[]
  passkeys            Passkey[]
  pushSubscriptions   PushSubscription[]
  monitorConfigs      ServerMonitorConfig[]
  oauthAccounts       OAuthAccount[]
  persistentSessions  PersistentSession[]
  sentInvitations     ServerInvitation[]    @relation("SentInvitations")
  ownedShares         ServerShare[]         @relation("OwnedShares")
  receivedShares      ServerShare[]         @relation("ReceivedShares")
  keychainCredentials KeychainCredential[]
  commandSnippets     CommandSnippet[]
  recordings          Recording[]
  tunnelSessions      TunnelSession[]
  workspaces          Workspace[]
  teamMemberships     TeamMember[]
  sshSecurityKeys     SshSecurityKey[]
  aiSettings          AiSettings?
  aiConversations     AiConversation[]
  aiMemories          AiMemory[]
  devices             Device[]

  @@index([email])
  @@index([passwordResetToken])
}

model Session {
  id     String @id @default(cuid())
  userId String

  // Session token (hashed for storage)
  tokenHash String @unique

  // Device and location info
  deviceInfo String // User agent / device description
  ipAddress  String

  // Session validity
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  /// Set while the app is locked (idle lock): every API but unlock refuses it.
  lockedAt     DateTime?

  // Session can be revoked by user
  isRevoked     Boolean   @default(false)
  revokedAt     DateTime?
  revokedReason String?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// SERVER MANAGEMENT

model ServerGroup {
  id     String @id @default(cuid())
  userId String

  name        String
  description String?
  color       String? // Hex color for UI
  icon        String? // Icon identifier
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  servers Server[]

  @@unique([userId, name])
  @@index([userId])
}

model Server {
  id      String  @id @default(cuid())
  userId  String
  groupId String?

  // Display info
  name        String
  description String?
  tags        String[]
  color       String?
  icon        String?

  // Connection info (encrypted)
  host     String // Encrypted: IP or hostname
  port     Int
  protocol Protocol

  // Credentials (encrypted)
  username    String // Encrypted
  password    String? // Encrypted (optional - for password auth)
  privateKey  String? // Encrypted (optional - for SSH key auth)
  passphrase  String? // Encrypted (optional - key passphrase)
  // OpenSSH user certificate for privateKey (`ssh-ed25519-cert-v01@openssh.com
  // AAAA…`). Public, like a public key, so stored as is.
  certificate String?

  // SSH agent forwarding: lets this server use the owner's keys (its own
  // login key plus the chosen keychain keys) while a terminal session is
  // open, without the keys ever leaving Termi. "off" | "on" | "confirm".
  agentForwarding  String   @default("off")
  agentKeychainIds String[] @default([])

  // Sign in with a FIDO2 security key (terminal sessions only: someone has
  // to touch the key). The server's sshd must accept
  // webauthn-sk-ecdsa-sha2-nistp256@openssh.com.
  securityKeyId String?
  securityKey   SshSecurityKey? @relation(fields: [securityKeyId], references: [id], onDelete: SetNull)

  // Jump host (bastion): connect to this server *through* another of the
  // owner's SSH servers. One hop only. The target host is then dialed by the
  // jump server, not by Termi, so it may be a private address.
  jumpServerId String?

  // Pinned SSH host key (like known_hosts): OpenSSH-style "SHA256:..." of the
  // key the server presented on first contact. Every SSH connection — web
  // and gateway — refuses a different key. Cleared when host or port change.
  hostKeyFingerprint String?
  hostKeyType        String?
  hostKeyTrustedAt   DateTime?

  // Additional settings
  notes      String? // Encrypted notes
  sshOptions Json? // Additional SSH options

  // For VNC/RDP specific settings
  displayWidth  Int?    @default(1920)
  displayHeight Int?    @default(1080)
  colorDepth    Int?    @default(24)
  // RDP security mode: "any" (default), "rdp", "nla", "tls"
  // Use "rdp" to bypass NLA if the server doesn't support it or credentials fail silently
  rdpSecurity   String? @default("any")

  // Favorites and usage
  /// Where SSH, file transfer and tunnels connect from in the desktop app:
  /// "server" (the Termi gateway), "device" (this computer) or "auto"
  /// (this computer, falling back to the gateway). Owner's servers only.
  connectFrom String    @default("server")
  isFavorite  Boolean   @default(false)
  lastUsedAt  DateTime?
  useCount    Int       @default(0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          ServerGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  connections    Connection[]
  monitorConfig  ServerMonitorConfig?
  healthRecords  ServerHealthRecord[]
  benchmarkRuns  BenchmarkRun[]
  recordings     Recording[]
  tunnelSessions TunnelSession[]
  invitations    ServerInvitation[]
  shares         ServerShare[]
  // NoAction, not SetNull: if a bastion vanished, its targets (often private
  // addresses) would start being dialed directly by this server. Deleting a
  // jump host that is still in use is refused instead (see deleteServer).
  jumpServer     Server?              @relation("JumpHost", fields: [jumpServerId], references: [id], onDelete: NoAction)
  jumpTargets    Server[]             @relation("JumpHost")
  hardeningRuns  ServerHardeningRun[]
  teams          TeamServer[]

  @@index([userId])
  @@index([groupId])
  @@index([protocol])
  @@index([isFavorite])
  @@index([jumpServerId])
}

// CONNECTION TRACKING

model Connection {
  id        String @id @default(cuid())
  serverId  String
  sessionId String

  protocol Protocol
  status   ConnectionStatus

  // Timing
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Stats
  bytesIn  BigInt @default(0)
  bytesOut BigInt @default(0)

  // Error info if failed
  errorMessage String?

  // Relations
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([sessionId])
  @@index([startedAt])
}

// PERSISTENT TERMINAL SESSIONS (cross-device session continuity)

model PersistentSession {
  id         String @id @default(cuid())
  userId     String
  sessionId  String @unique // stable UUID sent to the SSH gateway
  serverId   String
  serverName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// AUDIT LOGGING

model AuditLog {
  id     String  @id @default(cuid())
  userId String?

  action   AuditAction
  resource String? // e.g., "server:abc123"
  details  Json? // Additional action details

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, action, createdAt])
  @@index([action])
  @@index([createdAt])
}

// OAUTH ACCOUNTS

model OAuthAccount {
  id                String        @id @default(cuid())
  userId            String
  provider          OAuthProvider // e.g., GOOGLE
  providerAccountId String // Provider's user ID (Google `sub`)
  email             String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ENUMS

enum Protocol {
  SSH
  SCP
  RDP
  VNC
  TELNET
}

enum ConnectionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
}

enum WebhookPlatform {
  SLACK
  DISCORD
  GENERIC
}

enum TwoFactorMethod {
  NONE
  TOTP
  EMAIL
}

// PASSKEYS (WebAuthn / FIDO2)

model Passkey {
  id                  String    @id @default(cuid())
  userId              String
  name                String    @default("Passkey") // User-visible device name
  credentialID        String    @unique // Base64URL-encoded credential ID
  credentialPublicKey Bytes // COSE-encoded public key
  counter             BigInt    @default(0) // Signature counter (replay protection)
  deviceType          String // 'singleDevice' | 'multiDevice'
  backedUp            Boolean   @default(false) // Synced passkey?
  transports          String[] // e.g. ["internal", "hybrid"]
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuditAction {
  // Auth events
  USER_REGISTER
  USER_LOGIN
  USER_LOGOUT
  USER_LOGIN_FAILED
  USER_2FA_ENABLED
  USER_2FA_DISABLED
  USER_PASSWORD_CHANGED
  USER_MASTER_KEY_SET
  USER_MASTER_KEY_REMOVED
  USER_RECOVERY_CODE_USED
  USER_EMAIL_VERIFIED
  USER_OAUTH_LINKED
  USER_PASSWORD_RESET_REQUESTED
  USER_PASSWORD_RESET
  USER_ENCRYPTION_SETUP
  USER_ENCRYPTION_KEY_RESET
  SERVER_CREDENTIAL_REVEALED

  // Session events
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED

  // Server events
  SERVER_CREATED
  SERVER_UPDATED
  SERVER_DELETED

  // Connection events
  CONNECTION_STARTED
  CONNECTION_ENDED
  CONNECTION_FAILED

  // Group events
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_DELETED
  GROUP_BROADCAST_RUN
  SERVERS_COMMAND_RUN

  // Teams
  TEAM_CREATED
  TEAM_DELETED
  TEAM_MEMBER_INVITED
  TEAM_MEMBER_JOINED
  TEAM_MEMBER_REMOVED
  TEAM_ROLE_CHANGED
  TEAM_SERVER_ADDED
  TEAM_SERVER_REMOVED

  // Shared live sessions
  SESSION_SHARED
  SESSION_JOINED

  // FIDO2 security keys for SSH
  SSH_SECURITY_KEY_ADDED
  SSH_SECURITY_KEY_REMOVED

  // Passkey events
  PASSKEY_REGISTERED
  PASSKEY_REMOVED
  PASSKEY_USED

  // Sharing events
  SERVER_INVITE_SENT
  SERVER_INVITE_ACCEPTED
  SERVER_INVITE_DECLINED
  SERVER_SHARE_REVOKED

  // Keychain events
  KEYCHAIN_CREATED
  KEYCHAIN_UPDATED
  KEYCHAIN_DELETED
  KEYCHAIN_REVEALED
  USER_PASSWORD_LOGIN_TOGGLED

  // Bulk transfer events — every export is a credential-exposure event and is
  // logged whether or not it succeeded.
  SERVERS_EXPORTED
  SERVERS_IMPORTED

  // Command snippet events
  SNIPPET_CREATED
  SNIPPET_UPDATED
  SNIPPET_DELETED

  // A terminal, file browser or desktop was opened (History page)
  CONNECTION_OPENED
  AI_SETTINGS_UPDATED
  DEVICE_REGISTERED

  // Port-forward tunnel events
  TUNNEL_OPENED
  TUNNEL_CLOSED

  // Session recording events
  RECORDING_SAVED
  RECORDING_DELETED

  // Security hardening events
  SERVER_HARDENED
  SERVER_HARDENING_FAILED

  // SSH host key pinning
  SERVER_HOST_KEY_TRUSTED
  SERVER_HOST_KEY_MISMATCH
}

// PUSH NOTIFICATIONS

model PushSubscription {
  id     String @id @default(cuid())
  userId String

  // Web Push subscription data
  endpoint  String @unique
  p256dhKey String // auth.p256dh
  authKey   String // auth.auth

  // Device label (optional)
  deviceLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// SERVER MONITORING

model ServerMonitorConfig {
  id       String @id @default(cuid())
  serverId String @unique
  userId   String

  // Toggle monitoring on/off
  enabled Boolean @default(false)

  // Check interval in minutes (1, 5, 10, 15, 30, 60)
  checkIntervalMinutes Int @default(5)

  // Alert preferences
  alertEmail Boolean @default(true)
  alertPush  Boolean @default(true)

  // Webhook alert (Slack / Discord / generic JSON POST)
  webhookEnabled  Boolean          @default(false)
  webhookPlatform WebhookPlatform?
  webhookUrl      String? // Encrypted

  // How many consecutive failures before alerting (default 3)
  failureThreshold Int @default(3)

  // Current failure streak (reset on recovery)
  consecutiveFailures Int @default(0)

  // Whether an alert has already been sent for the current outage
  alertSent Boolean @default(false)

  // Last check timestamp
  lastCheckedAt DateTime?

  // Last known status
  lastStatus Boolean @default(true) // true = up, false = down

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

model ServerHealthRecord {
  id       String @id @default(cuid())
  serverId String

  // Result
  reachable Boolean
  latencyMs Int?

  // SSH metrics (null for non-SSH servers)
  cpuPercent  Float?
  ramPercent  Float?
  diskPercent Float?

  checkedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, checkedAt])
}

model BenchmarkRun {
  id       String @id @default(cuid())
  serverId String

  // Composite 0-1000 scores (see benchmark.service.ts computeScores)
  cpuScore     Int
  ramScore     Int
  diskScore    Int
  networkScore Int
  overallScore Int

  // Raw figures, for display alongside the scores
  cpuSingleMBps Int?
  cpuMultiMBps  Int?
  ramWriteMBps  Int?
  ramReadMBps   Int?
  diskWriteMBps Int?
  diskReadMBps  Int?
  pingMs        Float?

  runAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, runAt])
}

model Recording {
  id       String  @id @default(cuid())
  userId   String
  // Nullable + SetNull: a recording is an audit/handoff artifact that should
  // outlive the server it was taken of, unlike health/benchmark history.
  serverId String?

  // Snapshotted at record time so the label survives server rename/deletion.
  serverName String

  // Full asciicast v2 text (header line + newline-delimited [t,"o",data] events).
  content     String // Encrypted
  durationSec Int
  sizeBytes   Int

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// How a tunnel's data path actually flows — see apps/web/src/app/api/tunnels/route.ts.
enum TunnelMode {
  LOCAL // ssh -L: remoteHost:remotePort is the target, seen from the server
  DYNAMIC // ssh -D: a SOCKS proxy; remoteHost is "*" and remotePort 0
  REMOTE // ssh -R: the server listens on remoteHost:remotePort and reaches localHost:localPort
}

enum TunnelKind {
  HTTP_PROXY // one-click browser link at /tunnel/[serverId]/[port]
  BRIDGE_SCRIPT // copyable local Node.js script (web, non-HTTP target)
  ELECTRON_LOCAL // real local TCP port bound by the desktop shell
}

/// A record of a tunnel the user opened, for the "Active Tunnels" list.
/// This is a self-reported bookkeeping record, not a live connection probe —
/// the same limitation PersistentSession already has: if the client never
/// gets a chance to mark it closed (browser killed, laptop lid shut), the
/// row goes stale until the user removes it manually. The gateway's own
/// TunnelSlotLimiter is the actual security boundary on concurrent tunnels;
/// this table exists purely so the user can see and manage what they opened.
model TunnelSession {
  id       String  @id @default(cuid())
  userId   String
  // Nullable + SetNull: a history/management record that should outlive the
  // server it points at, same reasoning as Recording.serverId.
  serverId String?

  // Snapshotted at open time so the label survives server rename/deletion.
  serverName String

  remoteHost String
  remotePort Int
  kind       TunnelKind
  mode       TunnelMode @default(LOCAL)

  // Only set for kind = ELECTRON_LOCAL: the port actually bound on the
  // user's machine, and the id used to ask the desktop shell to close it.
  localPort  Int?
  electronId String?
  // REMOTE only: the host of the service on the user's machine.
  localHost  String?

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([userId, closedAt])
}

// RECOVERY CODES

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // scrypt hash of the code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// EMAIL OTP

model EmailOTP {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // scrypt hash of the 6-digit OTP
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// OAUTH PROVIDERS

enum OAuthProvider {
  GOOGLE
  OIDC // single sign-on (OIDC_ISSUER); providerAccountId is "<issuer>|<sub>"
}

// KEYCHAIN – reusable credential sets

/// A one-tap command for the terminal toolbar.
///
/// Not encrypted: unlike a keychain entry these are commands the user types
/// into their own shell, not secrets. Anything sensitive belongs in a
/// credential field — the UI says so at the point of entry.
model CommandSnippet {
  id     String @id @default(cuid())
  userId String

  label   String // Button text
  command String // Sent to the active shell verbatim
  icon    String? // lucide icon identifier

  /// When true the command is followed by a newline (executes immediately).
  /// When false it is typed into the prompt for the user to review and confirm.
  runImmediately Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model KeychainCredential {
  id     String @id @default(cuid())
  userId String

  // Friendly label shown in pickers
  label String

  // Credentials (all encrypted with AES-256-GCM)
  username    String // Encrypted
  password    String? // Encrypted (optional – password auth)
  privateKey  String? // Encrypted (optional – SSH key auth)
  passphrase  String? // Encrypted (optional – key passphrase)
  // OpenSSH user certificate for privateKey (public, stored as is).
  certificate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// SERVER SHARING & INVITATIONS

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model ServerInvitation {
  id           String           @id @default(cuid())
  token        String           @unique // crypto-random 32-byte hex, used in email link
  serverId     String
  inviterId    String
  inviteeEmail String // email of the person being invited
  permissions  String           @default("manage") // "manage" | "connect"
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime         @default(now())

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  inviter User   @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([inviterId])
  @@index([inviteeEmail])
  @@index([serverId])
}

model ServerShare {
  id           String   @id @default(cuid())
  serverId     String
  ownerId      String
  sharedWithId String
  permissions  String   @default("manage") // "manage" | "connect"
  createdAt    DateTime @default(now())

  server     Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  owner      User   @relation("OwnedShares", fields: [ownerId], references: [id], onDelete: Cascade)
  sharedWith User   @relation("ReceivedShares", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([serverId, sharedWithId])
  @@index([ownerId])
  @@index([sharedWithId])
}

/// One "secure this server" run (lib/services/hardening/harden.service.ts).
model ServerHardeningRun {
  id            String    @id @default(cuid())
  serverId      String
  userId        String
  /// running | succeeded | failed | rollback-pending
  status        String
  /// The options the user picked (no secrets).
  options       Json
  /// Step-by-step outcome, as streamed to the browser.
  steps         Json      @default("[]")
  /// Encrypted JSON of the new credentials, written BEFORE they are put to use
  /// on the server and cleared once committed to the Server row — so a crash
  /// mid-run never leaves a password set that Termi has no record of.
  pendingSecret String?
  message       String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
}

// SAVED WORKSPACES

/// A named set of terminal sessions and how they are split on screen, so a
/// recurring setup (web + db + logs side by side) opens in one click.
model Workspace {
  id     String @id @default(cuid())
  userId String
  name   String

  /// [{ serverId: string | null (null = local terminal) }], in tab order.
  tabs  Json
  /// { layout: 'columns' | 'rows' | 'grid', panes: number[] (indexes into tabs), x, y }
  split Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

// TEAMS

enum TeamRole {
  OWNER // everything, including deleting the team and changing roles
  ADMIN // invite and remove members, remove any server from the team
  MEMBER // connect to the team's servers, add servers they own
}

/// A group of users sharing a vault of servers. Each server stays owned (and
/// its credentials sealed) by the user who added it; members can connect.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     TeamMember[]
  servers     TeamServer[]
  invitations TeamInvitation[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamServer {
  id        String   @id @default(cuid())
  teamId    String
  serverId  String
  addedById String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([teamId, serverId])
  @@index([serverId])
}

model TeamInvitation {
  id          String   @id @default(cuid())
  teamId      String
  email       String
  role        TeamRole @default(MEMBER)
  /// SHA-256 of the token in the emailed link.
  tokenHash   String   @unique
  invitedById String
  status      String   @default("PENDING") // PENDING | ACCEPTED | REVOKED
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// A link that lets someone ask to join a live terminal session (watch, or
/// type too). The owner still approves each person in the terminal.
model SessionShare {
  id        String    @id @default(cuid())
  /// SHA-256 of the code in the link.
  codeHash  String    @unique
  ownerId   String
  /// The gateway session id (PersistentSession.sessionId) being shared.
  sessionId String
  serverId  String
  mode      String // "view" | "control"
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([ownerId])
}

/// A FIDO2 security key (YubiKey, …) used as an SSH key: the private key never
/// leaves the device. Enrolled through WebAuthn; `publicKey` is the OpenSSH
/// `sk-ecdsa-sha2-nistp256@openssh.com` key blob whose application is `rpId`.
model SshSecurityKey {
  id           String    @id @default(cuid())
  userId       String
  label        String
  credentialId String    @unique // base64url
  publicKey    String // OpenSSH key blob, base64
  rpId         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  servers Server[]

  @@index([userId])
}

// ── AI assistant (lib/ai, lib/services/ai.service.ts) ─────────────────────────

/// A user's own AI provider. Without it (or with useOwn off) the deployment's
/// AI_* settings apply.
model AiSettings {
  id            String   @id @default(cuid())
  userId        String   @unique
  /// "anthropic" | "openai" (OpenAI or any OpenAI-compatible endpoint)
  provider      String   @default("anthropic")
  model         String?
  /// Custom endpoint (vLLM, Ollama, a proxy). Checked like any host Termi dials.
  baseUrl       String?
  apiKey        String? // Encrypted
  useOwn        Boolean  @default(false)
  memoryEnabled Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String // Encrypted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
}

/// Stored after redaction, so history never holds a secret.
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  /// "user" | "assistant"
  role           String
  content        String // Encrypted
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Lasting facts the assistant keeps about the user's setup and preferences.
model AiMemory {
  id        String   @id @default(cuid())
  userId    String
  content   String // Encrypted
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A desktop app that can connect to its user's own servers directly.
/// Holds public keys only; tied to the sign-in that registered it, so signing
/// that device out ends it too.
model Device {
  id         String   @id @default(cuid())
  userId     String
  sessionId  String   @unique
  /// JWK thumbprint of the signing key: how the device's gateway is known.
  keyId      String   @unique
  /// Public P-256 keys (JWK): one for sealing tokens to it, one it signs with.
  encKey     Json
  sigKey     Json
  name       String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
