# =============================================================================
# Termi — Web App (.env.example)
# Copy to .env and fill in your values.
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# =============================================================================
# DATABASE  (pick ONE approach)
# =============================================================================

# Option A — split connection params (recommended)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=termi
DB_PASSWORD=your-db-password
DB_NAME=termi
DB_SCHEMA=public

# Option B — full connection URL (used as fallback if split vars not set)
# DATABASE_URL=postgresql://termi:your-db-password@your-db-host:5432/termi?schema=public

# =============================================================================
# SECURITY KEYS  (required — generate unique values per deployment)
# =============================================================================

# iron-session cookie encryption key  (min 32 chars)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# AES-256-GCM key for encrypting server credentials at rest
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Shared secret with the gateway for JWE connection token signing/verification
GATEWAY_JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# =============================================================================
# GATEWAY  (required)
# =============================================================================

# Browser-visible WebSocket URL of the gateway (read server-side at runtime, not baked at build).
# Use ws:// for local dev / wss:// for production TLS.
NEXT_PUBLIC_GATEWAY_URL=wss://gateway.example.com

# =============================================================================
# APP URL  (required for email links, OAuth callback, push notifications)
# =============================================================================

# Public-facing base URL of this web app — no trailing slash
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Sitemap base URL  (defaults to project GitHub repo if omitted)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# =============================================================================
# OAUTH — GOOGLE  (optional — enables "Sign in with Google")
# =============================================================================

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# =============================================================================
# SMTP  (optional — falls back to console log in dev when not configured)
# =============================================================================

 SMTP_HOST=smtp.gmail.com
 SMTP_PORT=587
 SMTP_SECURE=false
 SMTP_USER=your@email.com
 SMTP_PASS=your-app-password
 SMTP_FROM="Termi <noreply@your-domain.com>"

# =============================================================================
# WEB PUSH — VAPID  (optional — enables browser push notifications)
# Generate keys with: npx web-push generate-vapid-keys
# =============================================================================

 VAPID_PUBLIC_KEY=your-vapid-public-key
 VAPID_PRIVATE_KEY=your-vapid-private-key
 VAPID_SUBJECT=mailto:admin@your-domain.com

# =============================================================================
# NETWORK SECURITY  (optional)
# =============================================================================

# Allow servers on private/internal IPs (192.168.x.x, 10.x.x.x, 172.16.x.x).
# Safe for self-hosted / home-lab. Do NOT enable in public-facing deployments.
ALLOW_PRIVATE_NETWORKS=false

# Set to "true" when this app runs behind a trusted reverse proxy (Nginx, Traefik, Caddy).
# Enables reading the real client IP from the X-Forwarded-For header.
TRUSTED_PROXY=false


# =============================================================================
# MISC
# =============================================================================

NEXT_TELEMETRY_DISABLED=1
# DEBUG=true