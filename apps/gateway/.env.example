# =============================================================================
# Termi — Gateway App (.env.example)
# Copy to .env and fill in your values.
# The gateway is a standalone WebSocket server — it has NO database connection.
# =============================================================================

# =============================================================================
# SECURITY KEYS  (required — must match the web app's value exactly)
# =============================================================================

# Shared secret with the web app for JWE connection token verification.
# Must match GATEWAY_JWT_SECRET in apps/web/.env exactly.
GATEWAY_JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# =============================================================================
# SERVER BINDING  (optional — defaults shown)
# =============================================================================

# Port the gateway WebSocket server listens on
GATEWAY_PORT=22081

# Host/interface to bind to (0.0.0.0 = all interfaces)
GATEWAY_HOST=0.0.0.0

# =============================================================================
# CORS — ALLOWED ORIGINS  (optional)
# =============================================================================

# Comma-separated list of origins allowed to connect to the gateway.
# Defaults to NEXT_PUBLIC_APP_URL or http://localhost:22080 if not set.
ALLOWED_ORIGINS=http://localhost:22080
NEXT_PUBLIC_APP_URL=http://localhost:22080

# =============================================================================
# RDP / VNC — GUACD  (optional — required only if using RDP or VNC connections)
# Run guacd: docker run -d -p 4822:4822 --name termi-guacd guacamole/guacd: 1.6.0
# On Apple Silicon use: --platform linux/arm64
# =============================================================================

GUACD_HOST=localhost
GUACD_PORT=4822
# RDP/VNC through a jump host (optional). guacd cannot use an SSH channel, so
# the gateway relays its connection through the bastion. Set this to the
# address guacd uses to reach the gateway: `gateway` on the Docker network,
# `host.docker.internal` for a guacd container in local dev, or 127.0.0.1 if
# guacd runs on the same host. Unset = RDP/VNC jump hosts are refused.
# GUACD_TUNNEL_HOST=
# Interface the relay binds to (default 0.0.0.0, or 127.0.0.1 for a loopback host).
# GUACD_TUNNEL_BIND=

# =============================================================================
# NETWORK SECURITY  (optional)
# =============================================================================

# Allow connecting to servers on private/internal IPs (192.168.x.x=10.x.x.x=etc.).
# Safe for self-hosted / home-lab. Do NOT enable in public-facing deployments.
# Must match the web app's value.
ALLOW_PRIVATE_NETWORKS=false
