<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for the native macOS passkey bridge (electron-webauthn →
         Apple AuthenticationServices). See apps/electron/PASSKEYS.md.

         Replace TEAM_ID with your Apple Developer Team ID. The bundle id must
         match "build.appId" in the root package.json. -->
    <key>com.apple.application-identifier</key>
    <string>TEAM_ID.com.shuvoo.termi</string>

    <!-- Scope passkeys to the Termix domain (must match the server's WebAuthn
         rpID and be published in the domain's apple-app-site-association file). -->
    <key>com.apple.developer.associated-domains</key>
    <array>
        <string>webcredentials:termix.run</string>
    </array>

    <!-- Electron / hardened-runtime defaults -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
