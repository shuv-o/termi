  "_comment_gateway": "Set RUN_LOCAL_GATEWAY=true to start a gateway process on this machine.",
  "_comment_gateway2": "GATEWAY_JWT_SECRET must match the remote server's GATEWAY_JWT_SECRET.",
  "_comment_gateway3": "The remote server must set NEXT_PUBLIC_GATEWAY_URL=ws://localhost:22081.",
  "RUN_LOCAL_GATEWAY": "false",
  "GATEWAY_JWT_SECRET": "must-match-remote-server-secret",
  "GATEWAY_PORT": "22081",

  "_section_guacd": "--- LOCAL GUACD (optional — needed for RDP/VNC via local gateway) ---",
  "RUN_LOCAL_GUACD": "false"
