# =============================================================================
# Termi — Monorepo Root Environment Variables (.env.example)
#
# This file is the single source of truth for development.
# Copy to .env and fill in your values.
#
# For per-service documentation see:
#   apps/web/.env.example       — all web / Next.js variables
#   apps/gateway/.env.example   — gateway-only variables
#   apps/electron/.env.example  — Electron-shell variables
#   apps/electron/termi.config.json.example — packaged Electron config
#
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# =============================================================================
# DATABASE  (required — web app only; gateway has no DB connection)
# =============================================================================

# Option A — split connection params (recommended)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=termi
DB_PASSWORD=your-db-password
DB_NAME=termi
DB_SCHEMA=public

# Option B — full URL (used as fallback if split vars not set)
# DATABASE_URL=postgresql://termi:your-db-password@your-db-host:5432/termi?schema=public

# =============================================================================
# SECURITY KEYS  (required — must be identical across web app and gateway)
# Generate with: openssl rand -base64 32
# =============================================================================

# iron-session cookie encryption key  (min 32 chars)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# AES-256-GCM key for encrypting server credentials at rest
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Shared secret between web app and gateway for JWE connection token signing
GATEWAY_JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# =============================================================================
# GATEWAY  (required)
# =============================================================================

# Browser-visible WebSocket URL of the gateway (not baked at build time).
# Use ws:// for local dev / wss:// for production TLS.
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:22080/gateway

# ── Traefik routing (pick ONE mode) ──────────────────────────────────────────
# Mode 1 — path-based (same domain, Traefik strips prefix):
GATEWAY_PREFIX=/gateway
GATEWAY_DOMAIN=
# Mode 2 — separate domain:
# GATEWAY_PREFIX=
# GATEWAY_DOMAIN=gateway.example.com

# =============================================================================
# APP URL  (required for email links, OAuth, push notifications)
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:22080

# =============================================================================
# PORTS
# =============================================================================

WEB_PORT=22080
GATEWAY_PORT=22081

# =============================================================================
# CORS
# =============================================================================

# Comma-separated origins allowed to connect to the gateway.
# Defaults to NEXT_PUBLIC_APP_URL if not set.
ALLOWED_ORIGINS=http://localhost:22080,http://127.0.0.1:22080

# =============================================================================
# OAUTH — GOOGLE  (optional — enables "Sign in with Google")
# =============================================================================

# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:22080/api/auth/google/callback

# =============================================================================
# SMTP  (optional — console-logs email content in dev when not configured)
# =============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Termi <noreply@your-domain.com>"

# =============================================================================
# WEB PUSH — VAPID  (optional — enables browser push notifications)
# Generate keys with: npx web-push generate-vapid-keys
# =============================================================================

# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@your-domain.com

# =============================================================================
# RDP / VNC — GUACD  (optional — required only for RDP or VNC connections)
# docker run -d -p 4822:4822 --name termi-guacd guacamole/guacd:1.5.5
# Apple Silicon: add --platform linux/arm64
# =============================================================================

GUACD_HOST=localhost
GUACD_PORT=4822

# =============================================================================
# NETWORK SECURITY  (optional)
# =============================================================================

# Allow connecting to servers on private/internal IPs (192.168.x.x, 10.x.x.x etc.).
# Safe for self-hosted / home-lab. Do NOT enable in public-facing deployments.
ALLOW_PRIVATE_NETWORKS=false

# Set to "true" when running behind a trusted reverse proxy (Nginx, Traefik, Caddy).
# Enables reading the real client IP from X-Forwarded-For.
# TRUSTED_PROXY=false

# =============================================================================
# MISC
# =============================================================================

NEXT_TELEMETRY_DISABLED=1
# DEBUG=true
