# =============================================================================
# Termi — Monorepo Root Environment Variables (.env.example)
#
# This file is the single source of truth for development.
# Copy to .env and fill in your values.
#
# For per-service documentation see:
#   apps/web/.env.example       — all web / Next.js variables
#   apps/gateway/.env.example   — gateway-only variables
#   apps/electron/.env.example  — Electron-shell variables
#   apps/electron/termi.config.json.example — packaged Electron config
#
# Generate secrets with: openssl rand -base64 32
# =============================================================================

# =============================================================================
# DATABASE  (required — web app only; gateway has no DB connection)
# =============================================================================

# Option A — split connection params (recommended)
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=termi
DB_PASSWORD=your-db-password
DB_NAME=termi
DB_SCHEMA=public

# Option B — full URL (used as fallback if split vars not set)
# DATABASE_URL=postgresql://termi:your-db-password@your-db-host:5432/termi?schema=public

# =============================================================================
# SECURITY KEYS  (required — must be identical across web app and gateway)
# Generate with: openssl rand -base64 32
# =============================================================================

# iron-session cookie encryption key  (min 32 chars)
SESSION_SECRET=change-me-generate-with-openssl-rand-base64-32

# AES-256-GCM key for encrypting server credentials at rest
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Shared secret between web app and gateway for JWE connection token signing
GATEWAY_JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# =============================================================================
# GATEWAY  (required)
# =============================================================================

# Browser-visible WebSocket URL of the gateway (not baked at build time).
# Use ws:// for local dev / wss:// for production TLS.
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:22080/gateway

#   Traefik routing (pick ONE mode)
# Mode 1 — path-based (same domain, Traefik strips prefix):
GATEWAY_PREFIX=/gateway
GATEWAY_DOMAIN=
# Mode 2 — separate domain:
# GATEWAY_PREFIX=
# GATEWAY_DOMAIN=gateway.example.com

# =============================================================================
# APP URL  (required for email links, OAuth, push notifications)
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:22080

# =============================================================================
# PORTS
# =============================================================================

WEB_PORT=22080
GATEWAY_PORT=22081

# =============================================================================
# TERMINAL SESSIONS
# =============================================================================
# A terminal keeps running on the gateway after its browser tab closes. It is
# closed after GATEWAY_IDLE_TTL_HOURS with no output and no typing, and any
# terminal is closed after GATEWAY_MAX_SESSION_DAYS (0 = no limit).

# GATEWAY_IDLE_TTL_HOURS=8
# GATEWAY_MAX_SESSION_DAYS=7

# Open connections whose access ends (device signed out, password changed or
# reset, share removed, left the team, server deleted, share link turned off)
# are closed: the gateway asks the web app every GATEWAY_ACCESS_CHECK_SEC
# (default 30; 0 = off) at WEB_INTERNAL_URL (default NEXT_PUBLIC_APP_URL).
# GATEWAY_ACCESS_CHECK_SEC=30
# WEB_INTERNAL_URL=http://web:22080

# =============================================================================
# CORS
# =============================================================================

# Comma-separated origins allowed to connect to the gateway.
# Defaults to NEXT_PUBLIC_APP_URL if not set.
ALLOWED_ORIGINS=http://localhost:22080,http://127.0.0.1:22080

# =============================================================================
# OAUTH — GOOGLE  (optional — enables "Sign in with Google")
# =============================================================================

# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Single sign-on (OpenID Connect). Redirect URI: <app>/api/auth/sso/callback
# OIDC_ISSUER=https://login.example.com
# OIDC_CLIENT_ID=termi
# OIDC_CLIENT_SECRET=change-me
# OIDC_NAME=Okta
# OIDC_ALLOWED_DOMAINS=example.com
# OIDC_ENFORCE_DOMAINS=example.com   # these domains must use SSO
# OIDC_TRUST_EMAIL=false
# GOOGLE_REDIRECT_URI=http://localhost:22080/api/auth/google/callback

# =============================================================================
# SMTP  (optional — console-logs email content in dev when not configured)
# =============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true for port 465
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Termi <noreply@your-domain.com>"

# =============================================================================
# WEB PUSH — VAPID  (optional — enables browser push notifications)
# Generate keys with: npx web-push generate-vapid-keys
# =============================================================================

# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:admin@your-domain.com

# =============================================================================
# RDP / VNC — GUACD  (optional — required only for RDP or VNC connections)
# docker run -d -p 4822:4822 --name termi-guacd guacamole/guacd: 1.6.0
# Apple Silicon: add --platform linux/arm64
# =============================================================================

GUACD_HOST=localhost
GUACD_PORT=4822
# RDP/VNC through a jump host (optional). guacd cannot use an SSH channel, so
# the gateway relays its connection through the bastion. Set this to the
# address guacd uses to reach the gateway: `gateway` on the Docker network,
# `host.docker.internal` for a guacd container in local dev, or 127.0.0.1 if
# guacd runs on the same host. Unset = RDP/VNC jump hosts are refused.
# GUACD_TUNNEL_HOST=
# Interface the relay binds to (default 0.0.0.0, or 127.0.0.1 for a loopback host).
# GUACD_TUNNEL_BIND=

# =============================================================================
# NETWORK SECURITY  (optional)
# =============================================================================

# Allow connecting to servers on private/internal IPs (192.168.x.x, 10.x.x.x etc.).
# Safe for self-hosted / home-lab. Do NOT enable in public-facing deployments.
ALLOW_PRIVATE_NETWORKS=false

# Which proxy sets the real client IP (used for rate limiting and audit logs).
# Leave unset if nothing sits in front of Termi. Otherwise one of:
#   cloudflare       trust CF-Connecting-IP (only if the origin accepts Cloudflare traffic alone)
#   x-real-ip        trust X-Real-IP from your nginx/Traefik/Caddy
#   x-forwarded-for  trust the last X-Forwarded-For entry ("true" means the same)
# TRUSTED_PROXY=

# AI assistant (optional). Offer one to everyone on this Termi; each user can
# also bring their own in Settings → AI assistant (their key is stored encrypted).
# Passwords, keys and tokens are removed from everything before it is sent.
#   AI_PROVIDER  anthropic | openai  (openai also means any OpenAI-compatible
#                server: vLLM, Ollama, LM Studio, a proxy)
#   AI_API_KEY   the provider key (ANTHROPIC_API_KEY / OPENAI_API_KEY also work)
#   AI_MODEL     any model name; Anthropic defaults to claude-opus-5-5
#   AI_BASE_URL  a custom endpoint, e.g. http://vllm:8000/v1
#   AI_MAX_TOKENS  longest reply, in tokens (default 16000)
# AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# Search engines. A private instance should set SEARCH_INDEXING=off: robots.txt,
# meta tags and an X-Robots-Tag header then keep every page out of search results.
# The signed-in app is never indexed either way. The verification tokens come from
# Google Search Console and Bing Webmaster Tools (HTML tag method).
# SEARCH_INDEXING=on
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Add includeSubDomains + preload to HSTS. Only for a domain whose every subdomain
# serves HTTPS and that you submit to hstspreload.org.
# HSTS_PRELOAD=false

# Serve every port-forward tunnel from its own origin, so tunneled web apps run
# unsandboxed and can keep their own logins. {id} is filled in per tunnel.
# Needs a wildcard DNS record + certificate pointing at this app, on a
# DIFFERENT registrable domain than Termi's (a subdomain of Termi's domain
# would be "same-site" with it).
# TUNNEL_ORIGIN_TEMPLATE=https://{id}.termi-tunnels.net

# Share rate limits across instances and restarts. Optional; without it they
# are kept in memory.
# REDIS_URL=redis://localhost:6379

# TLS to Postgres (require, verify-ca, verify-full) when it isn't local.
# DB_SSLMODE=verify-full

# Key rotation: keep retired keys here (comma-separated) while
# `npm run db:reseal` re-encrypts everything under ENCRYPTION_KEY.
# ENCRYPTION_KEY_PREVIOUS=
# Alternatively read keys from files (Docker/Kubernetes secrets):
# ENCRYPTION_KEY_FILE=/run/secrets/encryption_key

# =============================================================================
# GITHUB API  (optional)
# =============================================================================

# Raises the GitHub API rate limit from 60 to 5000 requests/hour, which lets the
# landing page show a near-live star count and refresh the desktop download
# links sooner. Everything works without it, just with longer cache TTLs.
#
# Reads public repo metadata only — use a fine-grained token with NO scopes
# ("Public repositories, read-only"). Never needs write access or private data.
# GITHUB_TOKEN=github_pat_...

# =============================================================================
# MISC
# =============================================================================

NEXT_TELEMETRY_DISABLED=1
# DEBUG=true

# =============================================================================
# ELECTRON DESKTOP APP
# =============================================================================

# URL of your deployed Termi instance (required for electron:dev)
# TERMI_REMOTE_URL=https://my-termi.example.com

# For electron:dev:full (runs full local stack — requires DATABASE_URL above)
# TERMI_REMOTE_URL=http://localhost:22080
